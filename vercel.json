{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run package:vidaa",
  "outputDirectory": "dist/vidaa",
  "rewrites": [
    {
      "source": "/((?!vidaa\\.html$|index\\.html$|index\\.js$|manifest\\.json$|sw\\.js$|icon\\.png$|largeIcon\\.png$|appinfo\\.json$|webOSUserScripts/|installer/|api/proxy$).*)",
      "destination": "/api/proxy"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/vidaa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/tv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
